 "segments": [
  {
   "s": 0.25,
   "e": 3.232,
   "text": "Ұшақтың терезесі неге шаршы емес, дөңгелек?"
  },
  {
   "s": 3.512,
   "e": 7.839,
   "text": "Үйдің терезесі шаршы, автобустың терезесі де шаршы."
  },
  {
   "s": 8.119,
   "e": 11.685,
   "text": "Ал ұшақта әрқашан дөңгелек, бір де бір бұрышы жоқ."
  },
  {
   "s": 11.965,
   "e": 14.842,
   "text": "Дизайнерлер әдемі болсын деп ойлады дейсің бе?"
  },
  {
   "s": 15.122,
   "e": 18.015,
   "text": "Жоқ, мұның артында үлкен трагедия жатыр."
  },
  {
   "s": 18.295,
   "e": 23.266,
   "text": "Бір кездері алғашқы реактивті жолаушылар ұшағы «Комета» аспанға көтеріледі."
  },
  {
   "s": 23.546,
   "e": 25.39,
   "text": "Терезелері кәдімгідей шаршы."
  },
  {
   "s": 25.67,
   "e": 28.471,
   "text": "Бәрі мәз: жылдам, биік, жайлы."
  },
  {
   "s": 28.751,
   "e": 32.615,
   "text": "Бірақ бір жылдың ішінде екі ұшақ аспанда бөлшектеніп кетеді."
  },
  {
   "s": 32.895,
   "e": 36.711,
   "text": "Инженерлер басын қатырады: бомба ма, найзағай ма?"
  },
  {
   "s": 36.991,
   "e": 41.007,
   "text": "Ақырында ұшақты су толы алып бакқа салып, мыңдаған рет сынайды."
  },
  {
   "s": 41.287,
   "e": 44.236,
   "text": "Сөйтсе, кінәлі — терезенің бұрышы екен."
  },
  {
   "s": 44.516,
   "e": 48.39,
   "text": "Әр ұшқан сайын салон іші ауаға толып, шар сияқты кебеді."
  },
  {
   "s": 48.67,
   "e": 52.729,
   "text": "Сол күш шаршы бұрышқа жиналады да, металл шаршап, жарылады."
  },
  {
   "s": 53.009,
   "e": 57.204,
   "text": "Ал дөңгелек терезеде бұрыш жоқ, күш жан-жаққа бірдей тарайды."
  },
  {
   "s": 57.484,
   "e": 60.825,
   "text": "Сондықтан келесі жолы иллюминаторға қарасаң, біліп қой:"
  },
  {
   "s": 61.105,
   "e": 64.59,
   "text": "бұл сән емес, бұл сенің аман-есен қонуың."
  }
 ]
}