 "scenes": [
  {
   "id": "s01",
   "at_word": 0,
   "say": "Ұшақтың терезесі неге шаршы емес, дөңгелек? — иллюминатор макро"
  },
  {
   "id": "s02",
   "at_word": 6,
   "say": "Үйдің терезесі шаршы — үй"
  },
  {
   "id": "s03",
   "at_word": 9,
   "say": "автобустың терезесі де шаршы — автобус"
  },
  {
   "id": "s04",
   "at_word": 13,
   "say": "Ал ұшақта әрқашан дөңгелек, бұрышы жоқ — ұшақ аспанда"
  },
  {
   "id": "s05",
   "at_word": 22,
   "say": "Дизайнерлер әдемі болсын деп ойлады ма — суретші"
  },
  {
   "id": "s06",
   "at_word": 29,
   "say": "Жоқ, мұның артында үлкен трагедия — найзағай"
  },
  {
   "id": "s07",
   "at_word": 35,
   "say": "Бір кездері алғашқы реактивті ұшақ «Комета» — ұшу жолағы"
  },
  {
   "id": "s08",
   "at_word": 42,
   "say": "аспанға көтеріледі — ұшып шығу"
  },
  {
   "id": "s09",
   "at_word": 44,
   "say": "Терезелері кәдімгідей шаршы — шаршы терезелер"
  },
  {
   "id": "s10",
   "at_word": 47,
   "say": "Бәрі мәз: жылдам, биік, жайлы — салон"
  },
  {
   "id": "s11",
   "at_word": 52,
   "say": "екі ұшақ аспанда бөлшектеніп кетеді — апат"
  },
  {
   "id": "s12",
   "at_word": 61,
   "say": "Инженерлер басын қатырады — инженерлер"
  },
  {
   "id": "s13",
   "at_word": 64,
   "say": "бомба ма, найзағай ма? — ой бұлттары"
  },
  {
   "id": "s14",
   "at_word": 68,
   "say": "ұшақты су толы алып бакқа салып — бак"
  },
  {
   "id": "s15",
   "at_word": 75,
   "say": "мыңдаған рет сынайды — есептегіш"
  },
  {
   "id": "s16",
   "at_word": 78,
   "say": "кінәлі — терезенің бұрышы — лупа"
  },
  {
   "id": "s17",
   "at_word": 84,
   "say": "салон ауаға толып, шар сияқты кебеді — үрлену"
  },
  {
   "id": "s18",
   "at_word": 94,
   "say": "Сол күш шаршы бұрышқа жиналады — бағыттар"
  },
  {
   "id": "s19",
   "at_word": 100,
   "say": "металл шаршап, жарылады — жарықшақ"
  },
  {
   "id": "s20",
   "at_word": 103,
   "say": "дөңгелек терезеде күш бірдей тарайды — дөңгелек"
  },
  {
   "id": "s21",
   "at_word": 112,
   "say": "келесі жолы иллюминаторға қарасаң — жолаушы"
  },
  {
   "id": "s22",
   "at_word": 119,
   "say": "бұл сенің аман-есен қонуың — қону"
  }
 ],
