 "segments": [
  {
   "s": 0.25,
   "e": 3.59,
   "text": "Қазақстан туралы бес факт, үшіншісін көп адам білмейді."
  },
  {
   "s": 3.87,
   "e": 8.017,
   "text": "Бірінші. Қазақстан — әлемдегі ең үлкен тоғыз елдің бірі."
  },
  {
   "s": 8.296,
   "e": 11.709,
   "text": "Аумағы 2,7 миллион шаршы шақырым."
  },
  {
   "s": 11.989,
   "e": 15.8,
   "text": "Ал теңізге шығатын жолы жоқ елдердің ішінде — ең үлкені."
  },
  {
   "s": 16.081,
   "e": 20.2,
   "text": "Екінші. Адамзаттың ғарышқа жолы осы жерден басталды."
  },
  {
   "s": 20.48,
   "e": 24.687,
   "text": "Байқоңыр — әлемдегі алғашқы әрі ең ірі ғарыш айлағы."
  },
  {
   "s": 24.967,
   "e": 30.13,
   "text": "1957 жылы Байқоңырдан алғашқы жасанды серік ұшырылды."
  },
  {
   "s": 30.41,
   "e": 36.358,
   "text": "Ал 1961 жылы Юрий Гагарин дәл осы жерден ғарышқа аттанды."
  },
  {
   "s": 36.638,
   "e": 38.989,
   "text": "Үшінші. Алманың отаны — Қазақстан."
  },
  {
   "s": 39.269,
   "e": 45.586,
   "text": "Ғалымдардың айтуынша, бүкіл әлемдегі алманың атасы — Алатаудағы жабайы Сиверс алмасы."
  },
  {
   "s": 45.866,
   "e": 50.103,
   "text": "Ол жабайы алма ағаштары тау баурайында әлі күнге дейін өседі."
  },
  {
   "s": 50.383,
   "e": 56.739,
   "text": "Төртінші. Каспий — жер шарындағы ең үлкен көл, және оның ұзын жағалауы бізде."
  },
  {
   "s": 57.019,
   "e": 60.279,
   "text": "Оның ауданы бүкіл Жапонияның ауданымен шамалас."
  },
  {
   "s": 60.559,
   "e": 65.074,
   "text": "Бесінші. Қазақ даласы — әлемдегі ең үлкен құрғақ дала."
  },
  {
   "s": 65.354,
   "e": 67.79,
   "text": "Қай факт сені таңғалдырды? Пікірге жаз."
  }
 ]
}