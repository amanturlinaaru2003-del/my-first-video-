 "segments": [
  {
   "s": 0.25,
   "e": 2.944,
   "text": "Жалақың түскен бойда қайда жоғалатынын білмейсің бе?"
  },
  {
   "s": 3.224,
   "e": 5.687,
   "text": "Онда 50/30/20 ережесін тыңда."
  },
  {
   "s": 5.967,
   "e": 9.915,
   "text": "Бұл ережені американдық сенатор Элизабет Уоррен танымал еткен."
  },
  {
   "s": 10.195,
   "e": 11.543,
   "text": "Табысыңды үш бөлікке бөл."
  },
  {
   "s": 11.823,
   "e": 15.69,
   "text": "Елу пайызы — қажеттілікке: пәтер, тамақ, жол, коммуналдық төлем."
  },
  {
   "s": 15.97,
   "e": 19.885,
   "text": "Отыз пайызы — қалауыңа: кафе, киім, кино, саяхат."
  },
  {
   "s": 20.165,
   "e": 23.96,
   "text": "Ал жиырма пайызы — болашағыңа: жинақ пен инвестиция."
  },
  {
   "s": 24.24,
   "e": 26.126,
   "text": "Мысалы, айлығың 300 мың теңге."
  },
  {
   "s": 26.406,
   "e": 28.273,
   "text": "150 мыңы — қажеттілікке."
  },
  {
   "s": 28.553,
   "e": 29.894,
   "text": "90 мыңы — өзіңе."
  },
  {
   "s": 30.174,
   "e": 31.909,
   "text": "Ал 60 мыңы — жинаққа."
  },
  {
   "s": 32.189,
   "e": 34.532,
   "text": "Бір жылда 720 мың теңге жиналады."
  },
  {
   "s": 34.812,
   "e": 37.174,
   "text": "Ал бес жылда — үш миллион алты жүз мың."
  },
  {
   "s": 37.454,
   "e": 41.709,
   "text": "Бұл — саяхат, көлікке бастама немесе жай ғана тыныш ұйқы."
  },
  {
   "s": 41.989,
   "e": 46.418,
   "text": "Жиналған ақшаның алдымен үш-алты айлық қорын жина, қалғанын инвестицияла."
  },
  {
   "s": 46.698,
   "e": 51.311,
   "text": "Ең бастысы: жинақты ай соңында емес, жалақы түскен күні бөліп қой."
  },
  {
   "s": 51.591,
   "e": 54.247,
   "text": "Алдымен өзіңе төле, содан кейін басқаларға."
  }
 ]
}