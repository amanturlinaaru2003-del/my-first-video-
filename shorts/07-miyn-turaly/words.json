 "segments": [
  {
   "s": 0.25,
   "e": 3.622,
   "text": "Миың туралы бес факт, соңғысы сені ойландырады."
  },
  {
   "s": 3.902,
   "e": 7.944,
   "text": "Мидың салмағы — денеңнің небәрі екі пайызы."
  },
  {
   "s": 8.224,
   "e": 12.055,
   "text": "Бірақ ол бүкіл энергияңның жиырма пайызын жұмсайды."
  },
  {
   "s": 12.335,
   "e": 15.3,
   "text": "Ішінде шамамен 86 миллиард нейрон бар."
  },
  {
   "s": 15.58,
   "e": 18.79,
   "text": "Бұл — Жердегі адамдардың санынан он есе көп."
  },
  {
   "s": 19.07,
   "e": 24.074,
   "text": "Нейрондар арасындағы сигнал сағатына төрт жүз шақырымға дейін жылдамдықпен жүреді."
  },
  {
   "s": 24.354,
   "e": 26.596,
   "text": "Бұл — жүрдек пойыздан да жылдам."
  },
  {
   "s": 26.876,
   "e": 32.021,
   "text": "Ал бүкіл мидың қуаты небәрі жиырма ватт, бір кішкентай шамдай ғана."
  },
  {
   "s": 32.301,
   "e": 34.134,
   "text": "Мидың төрттен үші — су."
  },
  {
   "s": 34.414,
   "e": 37.46,
   "text": "Сондықтан су аз ішсең, ойың да баяулайды."
  },
  {
   "s": 37.74,
   "e": 41.993,
   "text": "Ми ауырсынуды сезбейді, онда ауырсыну рецепторлары жоқ."
  },
  {
   "s": 42.273,
   "e": 46.712,
   "text": "Сол үшін кейбір операцияларды адам ояу жатқанда жасайды."
  },
  {
   "s": 46.992,
   "e": 49.775,
   "text": "Ал ең қызығы: ми түнде демалмайды."
  },
  {
   "s": 50.055,
   "e": 54.606,
   "text": "Ұйқыда ол күндізгі естеліктерді сұрыптап, керексіз қоқысты тазалайды."
  },
  {
   "s": 54.886,
   "e": 60.514,
   "text": "Әр жаңа дағды мида жаңа жол салады, сондықтан үйренуге ешқашан кеш емес."
  },
  {
   "s": 60.794,
   "e": 64.304,
   "text": "Ендеше бүгін ерте жат. Миың саған рахмет айтады."
  }
 ]
}