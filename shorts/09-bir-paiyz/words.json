 "segments": [
  {
   "s": 0.25,
   "e": 3.257,
   "text": "Күн сайын бар болғаны бір пайызға жақсарсаң не болады?"
  },
  {
   "s": 3.537,
   "e": 5.508,
   "text": "Бір пайыз — түк емес сияқты."
  },
  {
   "s": 5.788,
   "e": 9.178,
   "text": "Бір бет кітап. Бес минут жаттығу. Он жаңа сөз."
  },
  {
   "s": 9.458,
   "e": 11.35,
   "text": "Бірақ математика басқаша айтады."
  },
  {
   "s": 11.63,
   "e": 16.436,
   "text": "1,01-ді 365 рет көбейтсең, шамамен 37 шығады."
  },
  {
   "s": 16.716,
   "e": 19.34,
   "text": "Яғни бір жылда отыз жеті есе мықты боласың."
  },
  {
   "s": 19.62,
   "e": 22.074,
   "text": "Ал күн сайын бір пайызға нашарласаң ше?"
  },
  {
   "s": 22.354,
   "e": 27.788,
   "text": "0,99-ды 365 рет көбейтсең — небәрі 0,03."
  },
  {
   "s": 28.068,
   "e": 28.915,
   "text": "Нөлге жуық."
  },
  {
   "s": 29.195,
   "e": 31.146,
   "text": "Айырмашылық бір күнде көрінбейді."
  },
  {
   "s": 31.426,
   "e": 32.761,
   "text": "Бір аптада да көрінбейді."
  },
  {
   "s": 33.041,
   "e": 35.305,
   "text": "Бірақ бір жылдан кейін бұл — екі бөлек адам."
  },
  {
   "s": 35.585,
   "e": 39.288,
   "text": "Жапондар мұны кайдзен дейді: кішкентай, бірақ күнделікті қадам."
  },
  {
   "s": 39.568,
   "e": 43.109,
   "text": "Джеймс Клир «Атомдық әдеттер» кітабында дәл осыны айтады."
  },
  {
   "s": 43.389,
   "e": 46.153,
   "text": "Әр әдет — болашақ өзіңе берілген бір дауыс."
  },
  {
   "s": 46.433,
   "e": 49.358,
   "text": "Ендеше бүгінгі бір пайызыңды неге жұмсайсың?"
  }
 ]
}