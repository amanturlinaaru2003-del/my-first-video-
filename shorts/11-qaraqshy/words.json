 "segments": [
  {
   "s": 0.25,
   "e": 4.322,
   "text": "Қарақшы капитандар туралы бес факт. Соңғысына сенбейсің."
  },
  {
   "s": 4.602,
   "e": 10.495,
   "text": "Бірінші. Атақты Қарасақал шайқас алдында сақалына жанып тұрған пілтелер байлайтын."
  },
  {
   "s": 10.774,
   "e": 14.26,
   "text": "Түтін ішінен шыққан оны көріп, жау шайтан келді деп ойлаған."
  },
  {
   "s": 14.54,
   "e": 19.474,
   "text": "Екінші. Көзге таңылған қара таңғыш үнемі соқырлықтың белгісі емес."
  },
  {
   "s": 19.754,
   "e": 26.974,
   "text": "Бір болжам бойынша, қараңғы трюмге түскенде таңғышты екінші көзге ауыстырып, бірден көре алатын."
  },
  {
   "s": 27.254,
   "e": 32.888,
   "text": "Үшінші. Тұтқынды тақтаймен теңізге жіберу — көбіне киноның ойдан шығарғаны."
  },
  {
   "s": 33.168,
   "e": 38.31,
   "text": "Ал қазына көму одан да сирек: қарақшылар олжасын бірден жұмсап жіберетін."
  },
  {
   "s": 38.59,
   "e": 41.584,
   "text": "Төртінші. Қарақшы кемесінде демократия болған."
  },
  {
   "s": 41.864,
   "e": 47.888,
   "text": "Капитанды бүкіл экипаж дауыс беріп сайлаған, ал жараланған теңізшіге өтемақы төленген."
  },
  {
   "s": 48.168,
   "e": 52.084,
   "text": "Бесінші. Тарихтағы ең қуатты қарақшы — әйел адам."
  },
  {
   "s": 52.364,
   "e": 55.79,
   "text": "Қытайлық Чжэн И Сао мыңнан астам кемені басқарған."
  },
  {
   "s": 56.07,
   "e": 59.531,
   "text": "Оның қол астында жетпіс мыңға жуық қарақшы болған."
  },
  {
   "s": 59.811,
   "e": 64.579,
   "text": "Ең қызығы, ол ешқашан жеңілмей, қартайғанша тыныш өмір сүрген."
  },
  {
   "s": 64.859,
   "e": 68.525,
   "text": "Ал сен қай капитанның кемесінде жүзер едің? Пікірге жаз."
  }
 ]
}