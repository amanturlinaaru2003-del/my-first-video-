 "segments": [
  {
   "s": 0.25,
   "e": 2.305,
   "text": "Сен дүкенге тек нан алуға кірдің."
  },
  {
   "s": 2.585,
   "e": 4.779,
   "text": "Ал шыққанда қолыңда екі толы пакет."
  },
  {
   "s": 5.059,
   "e": 5.733,
   "text": "Таныс па?"
  },
  {
   "s": 6.013,
   "e": 8.509,
   "text": "Бұл кездейсоқ емес, бұл — жоспар."
  },
  {
   "s": 8.789,
   "e": 12.611,
   "text": "Байқадың ба, нан мен сүт әрқашан дүкеннің ең түкпірінде тұрады."
  },
  {
   "s": 12.891,
   "e": 16.792,
   "text": "Ең қажетті затқа жету үшін сен бүкіл дүкенді аралап өтесің."
  },
  {
   "s": 17.072,
   "e": 22.284,
   "text": "Кіре берісте — гүлдер мен жаңа піскен нанның иісі: көңілің көтеріліп, әмияныңды ашасың."
  },
  {
   "s": 22.564,
   "e": 26.872,
   "text": "Жол бойы — печенье, шоколад, акция, «екеуін ал, үшіншісі тегін»."
  },
  {
   "s": 27.152,
   "e": 31.018,
   "text": "Жемістер кіре берісте тұрады: жарқын түстер көңіліңді көтереді."
  },
  {
   "s": 31.298,
   "e": 34.909,
   "text": "Тәттілер кассаның дәл жанында, балаңның көз деңгейінде."
  },
  {
   "s": 35.189,
   "e": 38.776,
   "text": "Қымбат тауар сөренің ортасында, дәл көзіңнің алдында тұрады."
  },
  {
   "s": 39.056,
   "e": 43.359,
   "text": "Ал арзаны — ең төменде, еңкеюге ерініп, қымбатын аласың."
  },
  {
   "s": 43.639,
   "e": 45.577,
   "text": "Тіпті музыка да бекер ойнамайды."
  },
  {
   "s": 45.857,
   "e": 49.445,
   "text": "Баяу әуен ойнаса, адамдар да баяу жүріп, көбірек сатып алады."
  },
  {
   "s": 49.725,
   "e": 52.349,
   "text": "Арба да үлкен: бос арбаны толтырғың келеді."
  },
  {
   "s": 52.629,
   "e": 56.147,
   "text": "Бәрі де сенің дүкенде ұзағырақ жүруің үшін ойластырылған."
  },
  {
   "s": 56.427,
   "e": 59.143,
   "text": "Сондықтан дүкенге тізіммен бар, тоқ қарынмен бар."
  },
  {
   "s": 59.423,
   "e": 61.931,
   "text": "Әйтпесе нан үшін кіріп, несиемен шығасың."
  }
 ]
}