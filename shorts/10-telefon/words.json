 "segments": [
  {
   "s": 0.25,
   "e": 3.528,
   "text": "Телефоныңды күніне неше рет қолға аласың деп ойлайсың?"
  },
  {
   "s": 3.808,
   "e": 5.014,
   "text": "Он рет? Жиырма?"
  },
  {
   "s": 5.294,
   "e": 10.31,
   "text": "Зерттеулер бойынша, орташа адам телефонын күніне шамамен 100 рет тексереді."
  },
  {
   "s": 10.59,
   "e": 13.867,
   "text": "Бұл — ояу кезде әр он минут сайын."
  },
  {
   "s": 14.147,
   "e": 17.516,
   "text": "Ал экранға күніне төрт сағаттан астам уақыт кетеді."
  },
  {
   "s": 17.796,
   "e": 20.141,
   "text": "Бұл — жылына екі айға жуық өмір."
  },
  {
   "s": 20.421,
   "e": 24.17,
   "text": "Себебі әр хабарлама миыңа кішкене дофамин береді."
  },
  {
   "s": 24.45,
   "e": 27.361,
   "text": "Ми оны сыйлық деп қабылдап, тағы да күтеді."
  },
  {
   "s": 27.641,
   "e": 31.343,
   "text": "Дәл казинодағы ойын автоматы сияқты."
  },
  {
   "s": 31.623,
   "e": 33.725,
   "text": "Ал мұны қалай тоқтатуға болады?"
  },
  {
   "s": 34.005,
   "e": 36.912,
   "text": "Бірінші: қажетсіз хабарламаларды өшір."
  },
  {
   "s": 37.192,
   "e": 42.326,
   "text": "Екінші: экранды ақ-қара режимге қой, түрлі түс миды азғырмайды."
  },
  {
   "s": 42.606,
   "e": 45.557,
   "text": "Үшінші: жатын бөлмеге телефонды апарма."
  },
  {
   "s": 45.837,
   "e": 51.426,
   "text": "Төртінші: таңертең ояна салысымен телефонға емес, бір стақан суға қол соз."
  },
  {
   "s": 51.706,
   "e": 56.934,
   "text": "Ал енді осы видеоны көріп болған соң, телефонды қойып, терезеге бір қара."
  }
 ]
}