 "segments": [
  {
   "s": 0.25,
   "e": 3.768,
   "text": "Неге бағалар үнемі 999 теңгемен аяқталады?"
  },
  {
   "s": 4.048,
   "e": 5.232,
   "text": "Неге мың емес?"
  },
  {
   "s": 5.512,
   "e": 7.718,
   "text": "Бар болғаны бір теңгенің айырмасы ғой."
  },
  {
   "s": 7.998,
   "e": 9.681,
   "text": "Бірақ миың олай ойламайды."
  },
  {
   "s": 9.961,
   "e": 13.756,
   "text": "Ми бағаны солдан оңға оқиды да, бірінші цифрға жабысып қалады."
  },
  {
   "s": 14.036,
   "e": 17.054,
   "text": "999 — тоғыз жүз, ал 1000 — мың."
  },
  {
   "s": 17.334,
   "e": 20.426,
   "text": "Айырмасы бір теңге, бірақ сезімі мүлде басқа."
  },
  {
   "s": 20.706,
   "e": 23.921,
   "text": "Бағаны оқып болғанша, миың «тоғыз жүз» деп шешіп те қояды."
  },
  {
   "s": 24.201,
   "e": 26.953,
   "text": "Ғалымдар мұны «сол жақ цифр әсері» деп атайды."
  },
  {
   "s": 27.233,
   "e": 32.016,
   "text": "Бір тәжірибеде бір көйлекті 34, 39 және 44 долларға қойған."
  },
  {
   "s": 32.296,
   "e": 35.919,
   "text": "Ең көп сатылғаны — арзаны емес, 39 доллары болған!"
  },
  {
   "s": 36.199,
   "e": 39.171,
   "text": "Тоғызбен аяқталған баға «жеңілдік» сияқты көрінеді."
  },
  {
   "s": 39.451,
   "e": 43.253,
   "text": "Бұл айла киімде де, телефонда да, тіпті пәтер бағасында да бар."
  },
  {
   "s": 43.533,
   "e": 46.807,
   "text": "Ең қызығы, біз мұны біле тұра, бәрібір алданамыз."
  },
  {
   "s": 47.087,
   "e": 50.199,
   "text": "Сондықтан дүкендер бір теңгені қуана-қуана құрбан етеді."
  },
  {
   "s": 50.479,
   "e": 54.925,
   "text": "Келесі жолы 4990 деген бағаны көрсең, оны бес мың деп оқы."
  },
  {
   "s": 55.205,
   "e": 57.979,
   "text": "Әйтпесе бір теңгелік айла сені тағы да ұтып кетеді."
  }
 ]
}