 "segments": [
  {
   "s": 0.25,
   "e": 1.956,
   "text": "Эйфель мұнарасы жазда өседі."
  },
  {
   "s": 2.236,
   "e": 5.308,
   "text": "Иә, дәл солай, он бес сантиметрге дейін биіктейді."
  },
  {
   "s": 5.588,
   "e": 8.585,
   "text": "Ал оның биіктігі — шамамен үш жүз отыз метр."
  },
  {
   "s": 8.865,
   "e": 12.074,
   "text": "Туристер «бұл мұнара ма, әлде гүл ме?» деп күледі."
  },
  {
   "s": 12.354,
   "e": 13.952,
   "text": "Бірақ мұнда ешқандай сиқыр жоқ."
  },
  {
   "s": 14.232,
   "e": 16.878,
   "text": "Мұнара жеті мың тоннадан астам темірден жасалған."
  },
  {
   "s": 17.158,
   "e": 18.911,
   "text": "Ал темір қызса, ұлғаяды."
  },
  {
   "s": 19.191,
   "e": 22.761,
   "text": "Жазғы күн шыжып тұрғанда әр темір бөлшек сәл ғана созылады."
  },
  {
   "s": 23.041,
   "e": 25.243,
   "text": "Ал ондай бөлшектер он сегіз мыңнан асады!"
  },
  {
   "s": 25.523,
   "e": 28.771,
   "text": "Кішкене созылулар қосыла келе, мұнараның басы көкке көтеріледі."
  },
  {
   "s": 29.051,
   "e": 32.215,
   "text": "Таңертең аласа, түсте биік: мұнара дем алып тұрғандай."
  },
  {
   "s": 32.495,
   "e": 35.016,
   "text": "Оның үстіне, күн тек бір жағын ғана қыздырады."
  },
  {
   "s": 35.296,
   "e": 38.799,
   "text": "Сол жағы ұзарып, мұнараның басы күннен теріс қарай сәл иіледі."
  },
  {
   "s": 39.079,
   "e": 43.321,
   "text": "Күн көкте жылжыған сайын, мұнараның ұшы да ақырын шеңбер сызады."
  },
  {
   "s": 43.601,
   "e": 46.599,
   "text": "Қыста керісінше: суықта темір қысылып, мұнара аласарады."
  },
  {
   "s": 46.879,
   "e": 50.093,
   "text": "Сондықтан көпір мен рельстерде арнайы саңылау қалдырады."
  },
  {
   "s": 50.373,
   "e": 53.006,
   "text": "Әйтпесе жазда олар майысып, қисайып кетер еді."
  },
  {
   "s": 53.286,
   "e": 55.629,
   "text": "Ендеше жазда біреу «бойым өсті» десе, сенбе."
  },
  {
   "s": 55.909,
   "e": 58.09,
   "text": "Бұл сылтау тек Эйфель мұнарасына жарасады."
  }
 ]
}