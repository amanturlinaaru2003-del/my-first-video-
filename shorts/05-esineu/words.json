 "segments": [
  {
   "s": 0.25,
   "e": 2.92,
   "text": "Қазір мен есінеймін, ал сен де есінейсің."
  },
  {
   "s": 3.2,
   "e": 4.787,
   "text": "Сенбейсің бе? Күте тұр."
  },
  {
   "s": 5.067,
   "e": 6.565,
   "text": "Есінеу — жұқпалы."
  },
  {
   "s": 6.845,
   "e": 9.855,
   "text": "Біреу есінесе, бөлмедегілердің жартысы ілесе бастайды."
  },
  {
   "s": 10.135,
   "e": 12.704,
   "text": "Тіпті есінеу туралы оқудың өзі жеткілікті."
  },
  {
   "s": 12.984,
   "e": 15.531,
   "text": "Сабақта мұғалім есінесе, бүкіл сынып есінейді."
  },
  {
   "s": 15.811,
   "e": 19.445,
   "text": "Жиналыста бастық есінесе, бәрі есінейді, бірақ аузын жабады."
  },
  {
   "s": 19.725,
   "e": 23.254,
   "text": "Есінеу бізбен бірге туады: анасының ішіндегі нәресте де есінейді."
  },
  {
   "s": 23.534,
   "e": 26.143,
   "text": "Ғалымдар ұзақ таласты: біз неге есінейміз?"
  },
  {
   "s": 26.423,
   "e": 28.977,
   "text": "Бір болжам бойынша, есінеу миды салқындатады."
  },
  {
   "s": 29.257,
   "e": 32.442,
   "text": "Терең дем, суық ауа — мида желдеткіш қосылғандай."
  },
  {
   "s": 32.722,
   "e": 33.631,
   "text": "Ал неге жұғады?"
  },
  {
   "s": 33.911,
   "e": 36.987,
   "text": "Себебі біз жақындарымызды еріксіз қайталаймыз."
  },
  {
   "s": 37.267,
   "e": 41.725,
   "text": "Зерттеулер көрсеткендей, бөтен адамнан гөрі досыңның есінеуі тезірек жұғады."
  },
  {
   "s": 42.005,
   "e": 44.245,
   "text": "Тіпті иттер де иесінен есінеу жұқтырады."
  },
  {
   "s": 44.525,
   "e": 47.254,
   "text": "Демек, есінеу — жанашырлықтың белгісі."
  },
  {
   "s": 47.534,
   "e": 48.892,
   "text": "Ал енді шыныңды айт."
  },
  {
   "s": 49.172,
   "e": 51.882,
   "text": "Осы видеоны көріп отырып, неше рет есінедің?"
  }
 ]
}