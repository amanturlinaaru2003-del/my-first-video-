  {
   "id": "s03",
   "at_word": 7,
   "say": "Сенбейсің бе? Күте тұр — секундомер"
  },
  {
   "id": "s04",
   "at_word": 11,
   "say": "Есінеу — жұқпалы — ескерту белгісі"
  },
  {
   "id": "s05",
   "at_word": 14,
   "say": "бөлмедегілердің жартысы ілеседі — бөлме"
  },
  {
   "id": "s06",
   "at_word": 20,
   "say": "есінеу туралы оқудың өзі жеткілікті — кітап"
  },
  {
   "id": "s07",
   "at_word": 26,
   "say": "мұғалім есінесе, бүкіл сынып — сынып"
  },
  {
   "id": "s08",
   "at_word": 32,
   "say": "бастық есінесе, бәрі аузын жабады — жиналыс"
  },
  {
   "id": "s09",
   "at_word": 40,
   "say": "Есінеу бізбен бірге туады — нәресте"
  },
  {
   "id": "s10",
   "at_word": 44,
   "say": "анасының ішіндегі нәресте — УДЗ экраны"
  },
  {
   "id": "s11",
   "at_word": 49,
   "say": "Ғалымдар ұзақ таласты — дау"
  },
  {
   "id": "s12",
   "at_word": 52,
   "say": "біз неге есінейміз? — сұрақ"
  },
  {
   "id": "s13",
   "at_word": 55,
   "say": "миды салқындатады — ми мен мұз"
  },
  {
   "id": "s14",
   "at_word": 61,
   "say": "мида желдеткіш — желдеткіш"
  },
  {
   "id": "s15",
   "at_word": 69,
   "say": "Ал неге жұғады? — сұрақ белгісі"
  },
  {
   "id": "s16",
   "at_word": 72,
   "say": "жақындарымызды қайталаймыз — айна-достар"
  },
  {
   "id": "s17",
   "at_word": 77,
   "say": "Зерттеулер: бөтен адамнан гөрі — график"
  },
  {
   "id": "s18",
   "at_word": 82,
   "say": "досыңның есінеуі тезірек — дос"
  },
  {
   "id": "s19",
   "at_word": 86,
   "say": "иттер де иесінен — ит"
  },
  {
   "id": "s20",
   "at_word": 92,
   "say": "жанашырлықтың белгісі — жүрек"
