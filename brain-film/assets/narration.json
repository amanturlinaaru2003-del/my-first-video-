  {
   "id": "g60",
   "ch": "c5",
   "text": "*дәлелденбеген.*",
   "start": 88.998,
   "end": 90.28
  },
  {
   "id": "g61",
   "ch": "c6",
   "text": "Содан кейін",
   "start": 91.326,
   "end": 92.262
  },
  {
   "id": "g62",
   "ch": "c6",
   "text": "*өлім толқыны* басталады.",
   "start": 92.262,
   "end": 94.001
  },
  {
   "id": "g63",
   "ch": "c6",
   "text": "Нейрондар",
   "start": 94.404,
   "end": 95.128
  },
  {
   "id": "g64",
   "ch": "c6",
   "text": "энергиясын жоғалтып,",
   "start": 95.128,
   "end": 96.517
  },
  {
   "id": "g65",
   "ch": "c6",
   "text": "бірінен соң бірі",
   "start": 96.517,
   "end": 97.665
  },
  {
   "id": "g66",
   "ch": "c6",
   "text": "*сөнеді.*",
   "start": 97.665,
   "end": 98.269
  },
  {
   "id": "g67",
   "ch": "c6",
   "text": "Бұл толқын",
   "start": 98.671,
   "end": 99.548
  },
  {
   "id": "g68",
   "ch": "c6",
   "text": "миды *баяу шарлап* өтеді.",
   "start": 99.548,
   "end": 101.302
  },
  {
   "id": "g69",
   "ch": "c6",
   "text": "Ғалымдар оны",
   "start": 101.704,
   "end": 102.56
  },
  {
   "id": "g70",
   "ch": "c6",
   "text": "*деполяризация*",
   "start": 102.56,
   "end": 103.473
  },
  {
   "id": "g71",
   "ch": "c6",
   "text": "толқыны деп атайды.",
   "start": 103.473,
   "end": 104.728
  },
  {
   "id": "g72",
   "ch": "c7",
   "text": "Бірақ ми",
   "start": 105.774,
   "end": 106.409
  },
  {
   "id": "g73",
   "ch": "c7",
   "text": "*бір сәтте* өлмейді.",
   "start": 106.409,
   "end": 107.621
  },
  {
   "id": "g74",
   "ch": "c7",
   "text": "Шамамен",
   "start": 108.024,
   "end": 108.638
  },
  {
   "id": "g75",
   "ch": "c7",
   "text": "*төрт-алты минуттан* кейін",
   "start": 108.638,
   "end": 110.295
  },
  {
   "id": "g76",
   "ch": "c7",
   "text": "ауыр зақым басталады.",
   "start": 110.295,
   "end": 111.768
  },
  {
   "id": "g77",
   "ch": "c7",
   "text": "Екі мың он тоғызыншы жылы",
   "start": 112.17,
   "end": 113.913
  },
  {
   "id": "g78",
   "ch": "c7",
   "text": "*Йель* ғалымдары",
   "start": 113.913,
   "end": 114.971
  },
  {
   "id": "g79",
   "ch": "c7",
   "text": "шошқа миының",
   "start": 115.373,
   "end": 116.454
  },
  {
   "id": "g80",
   "ch": "c7",
   "text": "кейбір жасушаларын",
   "start": 116.454,
   "end": 117.969
  },
  {
   "id": "g81",
   "ch": "c7",
   "text": "*төрт сағаттан* кейін",
   "start": 118.371,
   "end": 119.79
  },
  {
   "id": "g82",
   "ch": "c7",
   "text": "ішінара жандандырды.",
   "start": 119.79,
   "end": 121.273
  },
  {
   "id": "g83",
   "ch": "c7",
   "text": "Бірақ *сана*",
   "start": 121.675,
   "end": 122.351
  },
  {
   "id": "g84",
   "ch": "c7",
   "text": "қайтып оралған жоқ.",
   "start": 122.351,
   "end": 123.495
  },
  {
   "id": "g85",
   "ch": "c7",
   "text": "Сондықтан алғашқы минуттарда",
   "start": 123.897,
   "end": 125.912
  },
  {
   "id": "g86",
   "ch": "c7",
   "text": "жасалған *жүрек массажы*",
   "start": 125.912,
   "end": 127.538
  },
  {
   "id": "g87",
   "ch": "c7",
   "text": "өмірді *сақтап қалады.*",
   "start": 127.94,
   "end": 129.253
  },
  {
   "id": "g88",
   "ch": "c8",
   "text": "Клиникалық өлімнен",
   "start": 130.299,
   "end": 131.492
  },
  {
   "id": "g89",
   "ch": "c8",
   "text": "*оралғандардың* кейбірі",
   "start": 131.492,
   "end": 132.857
  },
  {
   "id": "g90",
   "ch": "c8",
   "text": "ерекше нәрселерді айтады:",
   "start": 133.259,
   "end": 134.961
  },
  {
   "id": "g91",
   "ch": "c8",
   "text": "*тоннель,*",
   "start": 135.363,
   "end": 136.113
  },
  {
   "id": "g92",
   "ch": "c8",
   "text": "*жарқын жарық,*",
   "start": 136.113,
   "end": 137.203
  },
  {
   "id": "g93",
   "ch": "c8",
   "text": "денеден",
   "start": 137.605,
   "end": 138.139
  },
  {
   "id": "g94",
   "ch": "c8",
   "text": "*бөлініп шыққандай* сезім.",
   "start": 138.139,
   "end": 139.582
  },
  {
   "id": "g95",
   "ch": "c8",
   "text": "Мұны жүрегі тоқтап,",
   "start": 139.984,
   "end": 141.402
  },
  {
   "id": "g96",
   "ch": "c8",
   "text": "қайта тірілгендердің",
   "start": 141.402,
   "end": 142.884
  },
  {
   "id": "g97",
   "ch": "c8",
   "text": "шамамен",
   "start": 143.286,
   "end": 143.832
  },
  {
   "id": "g98",
   "ch": "c8",
   "text": "*он пайызы* айтады.",
   "start": 143.832,
   "end": 144.924
  },
  {
   "id": "g99",
   "ch": "c8",
   "text": "Ғалымдар мұны",
   "start": 145.326,
   "end": 146.465
  },
  {
   "id": "g100",
   "ch": "c8",
   "text": "*оттегі тапшылығымен*",
   "start": 146.465,
   "end": 148.03
  },
  {
   "id": "g101",
   "ch": "c8",
   "text": "және ми белсенділігінің",
   "start": 148.432,
   "end": 150.18
  },
  {
   "id": "g102",
   "ch": "c8",
   "text": "*өршуімен* түсіндіреді.",
   "start": 150.18,
   "end": 151.794
  },
  {
   "id": "g103",
   "ch": "c9",
   "text": "Өлім —",
   "start": 152.84,
   "end": 153.464
  },
  {
   "id": "g104",
   "ch": "c9",
   "text": "*бір сәт* емес.",
   "start": 153.464,
   "end": 154.574
  },
  {
   "id": "g105",
   "ch": "c9",
   "text": "Ол —",
   "start": 154.976,
   "end": 155.507
  },
  {
   "id": "g106",
   "ch": "c9",
   "text": "*процесс.*",
   "start": 155.507,
   "end": 156.343
  },
  {
   "id": "g107",
   "ch": "c9",
   "text": "Ал ми",
   "start": 156.745,
   "end": 157.176
  },
  {
   "id": "g108",
   "ch": "c9",
   "text": "соңғы сәтке дейін",
   "start": 157.176,
   "end": 158.255
  },
  {
   "id": "g109",
   "ch": "c9",
   "text": "*күреседі.*",
   "start": 158.255,
   "end": 158.902
  },
  {
   "id": "g110",
   "ch": "c9",
   "text": "Ғылым бұл сұраққа",
   "start": 159.305,
   "end": 160.88
  },
  {
   "id": "g111",
   "ch": "c9",
   "text": "әлі *толық жауап*",
   "start": 160.88,
   "end": 162.297
  },
  {
   "id": "g112",
   "ch": "c9",
   "text": "берген жоқ.",
   "start": 162.297,
   "end": 163.4
  }
 ]
}