 "sentences": [
  {
   "ch": "c1",
   "text": "Жүрек тоқтады.",
   "start": 0.4,
   "end": 1.427
  },
  {
   "ch": "c1",
   "text": "Енді миға не болады?",
   "start": 1.83,
   "end": 3.274
  },
  {
   "ch": "c2",
   "text": "Ми — дене салмағының небәрі екі пайызы.",
   "start": 4.32,
   "end": 7.771
  },
  {
   "ch": "c2",
   "text": "Бірақ ол оттегінің жиырма пайызын жұмсайды.",
   "start": 8.173,
   "end": 11.431
  },
  {
   "ch": "c2",
   "text": "Онда сексен алты миллиард нейрон бар.",
   "start": 11.833,
   "end": 14.914
  },
  {
   "ch": "c2",
   "text": "Олар бір-біріне электр сигналдарын жібереді.",
   "start": 15.317,
   "end": 18.383
  },
  {
   "ch": "c2",
   "text": "Бірақ миде оттегінің қоры жоқ.",
   "start": 18.785,
   "end": 21.312
  },
  {
   "ch": "c2",
   "text": "Ол әр секунд сайын қан ағысына тәуелді.",
   "start": 21.715,
   "end": 25.146
  },
  {
   "ch": "c3",
   "text": "Жүрек тоқтаса, миға қан бармайды.",
   "start": 26.192,
   "end": 28.768
  },
  {
   "ch": "c3",
   "text": "Он-жиырма секундта сана сөнеді.",
   "start": 29.171,
   "end": 31.127
  },
  {
   "ch": "c3",
   "text": "Нейрондар энергиясыз қалады.",
   "start": 31.53,
   "end": 33.788
  },
  {
   "ch": "c3",
   "text": "Олар бір-бірімен сөйлесуді тоқтатады.",
   "start": 34.19,
   "end": 37.021
  },
  {
   "ch": "c3",
   "text": "Ми толқындары әлсірейді...",
   "start": 37.423,
   "end": 39.536
  },
  {
   "ch": "c3",
   "text": "Монитордағы сызық түзу болады.",
   "start": 39.939,
   "end": 41.943
  },
  {
   "ch": "c4",
   "text": "Бірақ ғалымдар күтпеген нәрсені байқады.",
   "start": 42.989,
   "end": 45.683
  },
  {
   "ch": "c4",
   "text": "Кейде ми соңғы рет жарқ етеді.",
   "start": 46.085,
   "end": 49.087
  },
  {
   "ch": "c4",
   "text": "Бұл — гамма-толқындар.",
   "start": 49.489,
   "end": 50.994
  },
  {
   "ch": "c4",
   "text": "Олар ойлаумен және есте сақтаумен байланысты.",
   "start": 51.396,
   "end": 54.937
  },
  {
   "ch": "c4",
   "text": "Алдымен оны екі мың он үшінші жылы егеуқұйрықтардан көрді.",
   "start": 55.339,
   "end": 59.033
  },
  {
   "ch": "c4",
   "text": "Оларда бұл жарқыл отыз секундқа жуық созылды,",
   "start": 59.435,
   "end": 62.58
  },
  {
   "ch": "c4",
   "text": "ал ми тірі кездегіден де белсенді көрінді.",
   "start": 62.982,
   "end": 66.426
  },
  {
   "ch": "c4",
   "text": "Екі мың жиырма екінші жылы — сексен жеті жастағы адамнан.",
   "start": 66.828,
   "end": 70.784
  },
  {
   "ch": "c4",
   "text": "Екі мың жиырма үшінші жылы — төрт науқастың екеуінен.",
   "start": 71.186,
   "end": 74.849
  },
  {
   "ch": "c5",
   "text": "Бұл — өмірдің көз алдыңнан өтуі ме?",
   "start": 75.895,
   "end": 78.745
  },
  {
   "ch": "c5",
   "text": "Сексен жеті жастағы адамда бұл толқындар",
   "start": 79.147,
   "end": 82.114
  },
  {
   "ch": "c5",
   "text": "естеліктерді шақырғандағыдай көрінді.",
   "start": 82.516,
   "end": 85.056
  },
  {
   "ch": "c5",
   "text": "Кейбір ғалымдар солай болжайды.",
   "start": 85.459,
   "end": 87.389
  },
  {
   "ch": "c5",
   "text": "Бірақ бұл әлі дәлелденбеген.",
   "start": 87.792,
   "end": 90.28
  },
  {
   "ch": "c6",
   "text": "Содан кейін өлім толқыны басталады.",
   "start": 91.326,
   "end": 94.001
  },
  {
   "ch": "c6",
   "text": "Нейрондар энергиясын жоғалтып, бірінен соң бірі сөнеді.",
   "start": 94.404,
   "end": 98.269
  },
  {
   "ch": "c6",
   "text": "Бұл толқын миды баяу шарлап өтеді.",
   "start": 98.671,
   "end": 101.302
  },
  {
   "ch": "c6",
   "text": "Ғалымдар оны деполяризация толқыны деп атайды.",
   "start": 101.704,
   "end": 104.728
  },
  {
   "ch": "c7",
   "text": "Бірақ ми бір сәтте өлмейді.",
   "start": 105.774,
   "end": 107.621
  },
  {
   "ch": "c7",
   "text": "Шамамен төрт-алты минуттан кейін ауыр зақым басталады.",
   "start": 108.024,
   "end": 111.768
  },
  {
   "ch": "c7",
   "text": "Екі мың он тоғызыншы жылы Йель ғалымдары",
   "start": 112.17,
   "end": 114.971
  },
  {
   "ch": "c7",
   "text": "шошқа миының кейбір жасушаларын",
   "start": 115.373,
   "end": 117.969
  },
  {
   "ch": "c7",
   "text": "төрт сағаттан кейін ішінара жандандырды.",
   "start": 118.371,
   "end": 121.273
  },
  {
   "ch": "c7",
   "text": "Бірақ сана қайтып оралған жоқ.",
   "start": 121.675,
   "end": 123.495
  },
  {
   "ch": "c7",
   "text": "Сондықтан алғашқы минуттарда жасалған жүрек массажы",
   "start": 123.897,
   "end": 127.538
  },
  {
   "ch": "c7",
   "text": "өмірді сақтап қалады.",
   "start": 127.94,
   "end": 129.253
  },
  {
   "ch": "c8",
   "text": "Клиникалық өлімнен оралғандардың кейбірі",
   "start": 130.299,
   "end": 132.857
  },
  {
   "ch": "c8",
   "text": "ерекше нәрселерді айтады:",
   "start": 133.259,
   "end": 134.961
  },
  {
   "ch": "c8",
   "text": "тоннель, жарқын жарық,",
   "start": 135.363,
   "end": 137.203
  },
  {
   "ch": "c8",
   "text": "денеден бөлініп шыққандай сезім.",
   "start": 137.605,
   "end": 139.582
  },
  {
   "ch": "c8",
   "text": "Мұны жүрегі тоқтап, қайта тірілгендердің",
   "start": 139.984,
   "end": 142.884
  },
  {
   "ch": "c8",
   "text": "шамамен он пайызы айтады.",
   "start": 143.286,
   "end": 144.924
  },
  {
   "ch": "c8",
   "text": "Ғалымдар мұны оттегі тапшылығымен",
   "start": 145.326,
   "end": 148.03
  },
  {
   "ch": "c8",
   "text": "және ми белсенділігінің өршуімен түсіндіреді.",
   "start": 148.432,
   "end": 151.794
  },
  {
   "ch": "c9",
   "text": "Өлім — бір сәт емес.",
   "start": 152.84,
   "end": 154.574
  },
  {
   "ch": "c9",
   "text": "Ол — процесс.",
   "start": 154.976,
   "end": 156.343
  },
  {
   "ch": "c9",
   "text": "Ал ми соңғы сәтке дейін күреседі.",
   "start": 156.745,
   "end": 158.902
  },
  {
   "ch": "c9",
   "text": "Ғылым бұл сұраққа әлі толық жауап берген жоқ.",
   "start": 159.305,
   "end": 163.4
  }
 ],
