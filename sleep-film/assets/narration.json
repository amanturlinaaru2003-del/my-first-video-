{
 "sentences": [
  {
   "line": "l1",
   "text": "Шаршадың... бірақ неге ұйықтай алмай жатырсың?",
   "start": 0.5,
   "end": 3.568
  },
  {
   "line": "l2",
   "text": "Түнде миың тынбайды.",
   "start": 5.4,
   "end": 6.577
  },
  {
   "line": "l2",
   "text": "Ертеңгі істер, айтылмай қалған сөздер, уайым — бәрі ойыңа қайта орала береді.",
   "start": 6.917,
   "end": 13.332
  },
  {
   "line": "l3",
   "text": "Қараңғыда мелатонин бөлінеді — ұйқы гормоны.",
   "start": 15.3,
   "end": 19.087
  },
  {
   "line": "l3",
   "text": "Ал стресс кортизолды көтереді — ол сергек ұстап, ұйқыны қуады.",
   "start": 19.427,
   "end": 23.925
  },
  {
   "line": "l4",
   "text": "Ал біз түнде телефон ақтарамыз.",
   "start": 25.3,
   "end": 27.431
  },
  {
   "line": "l4",
   "text": "Көк жарық мелатонинді тежейді.",
   "start": 27.771,
   "end": 29.701
  },
  {
   "line": "l4",
   "text": "Кешкі кофе сағаттар бойы сергек ұстайды.",
   "start": 30.041,
   "end": 33.192
  },
  {
   "line": "l4",
   "text": "Сағатқа қараған сайын, уайым күшейеді.",
   "start": 33.532,
   "end": 36.671
  },
  {
   "line": "l5",
   "text": "Телефонды қой.",
   "start": 38.4,
   "end": 39.166
  },
  {
   "line": "l5",
   "text": "Жарықты сөндір.",
   "start": 39.506,
   "end": 40.516
  },
  {
   "line": "l5",
   "text": "Баяу дем ал...",
   "start": 40.856,
   "end": 41.801
  },
  {
   "line": "l5",
   "text": "Денең босаңсып, ойың тынышталады.",
   "start": 42.141,
   "end": 44.386
  },
  {
   "line": "l6",
   "text": "Ұйқыңды бағала.",
   "start": 46.3,
   "end": 47.404
  },
  {
   "line": "l6",
   "text": "Денеңе демалыс бер.",
   "start": 47.744,
   "end": 48.916
  }
 ],
