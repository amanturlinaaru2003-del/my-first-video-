{
 "sentences": [
  {
   "line": "l1",
   "text": "Шаршадың... бірақ неге ұйықтай алмай жатырсың?",
   "start": 0.5,
   "end": 3.716
  },
  {
   "line": "l2",
   "text": "Түнде миың тынбайды.",
   "start": 5.4,
   "end": 6.946
  },
  {
   "line": "l2",
   "text": "Ертеңгі істер, айтылмай қалған сөздер, уайым — бәрі ойыңа қайта орала береді.",
   "start": 7.286,
   "end": 13.537
  },
  {
   "line": "l3",
   "text": "Қараңғыда мелатонин бөлінеді — ұйқы гормоны.",
   "start": 15.3,
   "end": 19.869
  },
  {
   "line": "l3",
   "text": "Ал стресс кортизолды көтереді — ол сергек ұстап, ұйқыны қуады.",
   "start": 20.209,
   "end": 24.556
  },
  {
   "line": "l4",
   "text": "Ал біз түнде телефон ақтарамыз.",
   "start": 25.3,
   "end": 27.666
  },
  {
   "line": "l4",
   "text": "Көк жарық мелатонинді тежейді.",
   "start": 28.006,
   "end": 30.124
  },
  {
   "line": "l4",
   "text": "Кешкі кофе сағаттар бойы сергек ұстайды.",
   "start": 30.464,
   "end": 33.168
  },
  {
   "line": "l4",
   "text": "Сағатқа қараған сайын, уайым күшейеді.",
   "start": 33.508,
   "end": 36.028
  },
  {
   "line": "l5",
   "text": "Телефонды қой.",
   "start": 38.4,
   "end": 39.312
  },
  {
   "line": "l5",
   "text": "Жарықты сөндір.",
   "start": 39.652,
   "end": 40.693
  },
  {
   "line": "l5",
   "text": "Баяу дем ал...",
   "start": 41.033,
   "end": 41.923
  },
  {
   "line": "l5",
   "text": "Денең босаңсып, ойың тынышталады.",
   "start": 42.263,
   "end": 44.914
  },
  {
   "line": "l6",
   "text": "Ұйқыңды бағала.",
   "start": 46.3,
   "end": 47.329
  },
  {
   "line": "l6",
   "text": "Денеңе демалыс бер.",
   "start": 47.669,
   "end": 49.213
  }
 ],
