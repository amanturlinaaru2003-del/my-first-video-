{
 "sentences": [
  {
   "line": "l1",
   "text": "Біз қазір сенің миыңның ішіндеміз.",
   "start": 0.6,
   "end": 2.905
  },
  {
   "line": "l1",
   "text": "Мұнда сексен алты миллиард нейрон бар — әрқайсысы мыңдаған көршісімен байланысқан.",
   "start": 3.245,
   "end": 8.473
  },
  {
   "line": "l2",
   "text": "Бір ой туды... Ол электр импульсі болып, аксон бойымен жүгіреді.",
   "start": 10.0,
   "end": 14.306
  },
  {
   "line": "l3",
   "text": "Бірақ нейрондар бір-біріне тимейді.",
   "start": 16.5,
   "end": 18.87
  },
  {
   "line": "l3",
   "text": "Арасында кішкентай саңылау бар — бұл синапс.",
   "start": 19.21,
   "end": 22.495
  },
  {
   "line": "l4",
   "text": "Импульс жеткенде, көпіршіктер жарылып, нейромедиаторлар шашырайды.",
   "start": 24.5,
   "end": 28.965
  },
  {
   "line": "l5",
   "text": "Олар келесі нейронның рецепторларына қонады, және сигнал ары қарай жүреді.",
   "start": 30.5,
   "end": 36.731
  },
  {
   "line": "l6",
   "text": "Миллисекунд ішінде мыңдаған синапс жанады.",
   "start": 37.231,
   "end": 40.354
  },
  {
   "line": "l6",
   "text": "Осылай естелік, сезім және идея туады.",
   "start": 40.694,
   "end": 43.966
  },
  {
   "line": "l7",
   "text": "Сен үйренген сайын, бұл байланыстар күшейе түседі.",
   "start": 45.2,
   "end": 48.412
  }
 ],
